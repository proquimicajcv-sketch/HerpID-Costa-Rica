{
  "name": "herpid-costa-rica",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:resiliente",
    "dev:once": "vite --host 0.0.0.0 --port 3000",
    "dev:resiliente": "sh -c 'while true; do vite --host 0.0.0.0 --port 3000; code=$?; if [ $code -eq 0 ] || [ $code -eq 130 ]; then exit $code; fi; echo [dev] Vite se detuvo con codigo $code. Reiniciando en 2s...; sleep 2; done'",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
